rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection for authentication, authorization filter, and single-session tracking
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Shared / Admin uploaded custom presets accessible to all users
    match /shared_presets/{presetId} {
      allow read, write: if true;
    }

    // System configuration collection
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Real-time online user presence beacon collection
    match /online_presence/{sessionId} {
      allow read, write: if true;
    }

    // System statistics (visit counter, usage metrics)
    match /system_stats/{statId} {
      allow read, write: if true;
    }

    // Instant payment & subscription requests (UPI QR & UTR)
    match /subscription_requests/{requestId} {
      allow read, write: if true;
    }

    // Direct user messages and support tickets to Administrator
    match /user_messages/{messageId} {
      allow read, write: if true;
    }
  }
}
